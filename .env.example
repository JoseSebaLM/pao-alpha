# =====================================================================
# Variables de entorno - Paola Rioseco (copiar a .env.local y completar)
# NEXT_PUBLIC_* deben además declararse en wrangler.jsonc para producción.
# Secretos de producción: cargar con `wrangler secret put`, nunca en el repo.
# =====================================================================

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_B2B=true
NEXT_PUBLIC_ENABLE_B2B_LIBRARY=false

# --- reCAPTCHA v3 (PRIV-002) ---
# Obtener en https://www.google.com/recaptcha/admin
# Si RECAPTCHA_SECRET_KEY queda con el placeholder, la verificación se OMITE
# en el servidor (solo apto para desarrollo local).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# --- Email (Resend) - Fase 0 ---
# Sin esta clave, /api/contact responde 503 (los formularios no simulan éxito).
RESEND_API_KEY=
# Opcional. Con dominio sin verificar, Resend solo permite onboarding@resend.dev
# (envía únicamente al email de la cuenta). Con dominio verificado, usar algo como:
# RESEND_FROM_EMAIL="Paola Rioseco <no-reply@paolarioseco.com>"
RESEND_FROM_EMAIL=

# --- Mercado Pago (Checkout Pro) - Fase 1 ---
# Sin MP_ACCESS_TOKEN el funnel de pago queda dormido: la landing muestra
# "Consultar por WhatsApp" y /api/checkout/[slug] responde 503.
# Credenciales de producción de la cuenta de Paola (o TEST-* para sandbox).
MP_ACCESS_TOKEN=
# Base absoluta para back_urls y notification_url de la preferencia.
# Sin ella, /api/checkout/[slug] también responde 503.
NEXT_PUBLIC_SITE_URL=https://paolarioseco.com

# --- Webhook de pagos (Mercado Pago) - Fase 1 ---
# El secreto genérico anterior (PAYMENT_WEBHOOK_SECRET) ya no se usa: el
# webhook valida la firma oficial de MP (header x-signature).
PAYMENT_WEBHOOK_SECRET=tu_secreto_temporal_aqui
# MP_WEBHOOK_SECRET=

# --- Fases siguientes (aún no usadas) ---
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GLOBAL66_LINK=
